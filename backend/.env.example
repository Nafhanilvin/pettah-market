PORT=5000
NODE_ENV=development
# MySQL connection string for Prisma
DATABASE_URL=mysql://root:password@127.0.0.1:3306/pettah_market
# If using docker-compose.mysql.yml, this default works as-is.
# Alternative user from docker compose:
# DATABASE_URL=mysql://pettah_user:pettah_password@127.0.0.1:3306/pettah_market
JWT_SECRET=your_jwt_secret_key_here_change_this
JWT_EXPIRE=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
