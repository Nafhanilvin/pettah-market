{
  "name": "pettah-market-backend",
  "version": "1.0.0",
  "description": "Backend API for Pettah Market",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:up": "docker compose -f docker-compose.mysql.yml up -d",
    "db:down": "docker compose -f docker-compose.mysql.yml down",
    "db:wait": "node scripts/wait-mysql.js",
    "setup:easy": "node scripts/setup-easy.js",
    "setup:docker": "node scripts/setup-docker.js"
  },
  "keywords": [
    "marketplace",
    "pettah",
    "colombo",
    "ecommerce"
  ],
  "author": "Nafhanilvin",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "joi": "^17.9.0",
    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^6.4.1"
  }
}
